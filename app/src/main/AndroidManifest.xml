<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Mavick must never reach the network: messages stay on the phone. These lines strip the
        permissions even if a library asks for them, and the build's permission check
        (app/build.gradle.kts) fails if anything else sneaks in.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Phase 1. Each is also on the build's allow-list (app/build.gradle.kts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Phase 4: write tasks that have a time into a calendar the user picks, and read calendars to
        choose one (and, in a later part, to find clashes). Asked for when the user switches
        "Add tasks to my calendar" on in Settings, never at install. Also on the build's allow-list.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
        allowBackup=false keeps Mavick out of Google cloud backups. dataExtractionRules also
        blocks phone-to-phone transfer, which allowBackup alone does not cover on Android 12+.
    -->
    <application
        android:name=".MavickApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mavick">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Send to Mavick" from Google Keep or any app that shares text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            "Add to Mavick" in the menu Android shows for selected text, in any app (Gmail, a
            browser, notes): for long messages that notifications cut short. Needs no permission.
        -->
        <activity-alias
            android:name=".AddToMavick"
            android:exported="true"
            android:label="@string/process_text_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!--
            Reminders. None is exported: only Android itself and Mavick's own alarms and
            notification buttons can reach them; other apps can't.
        -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Phase 2: reads WhatsApp, Messenger, Gmail and Keep notifications once the user grants
            "Notification access". Only Android can bind it (the permission below is held by the
            system alone), and it only reads (docs/PLAN.md §5.1). Mavick's only service.
        -->
        <service
            android:name=".capture.MavickNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Only alerting and conversation notifications by default, so fewer wake-ups. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>

        <!-- Phone-friendly trimming of what libraries add (docs/PLAN.md §5.8). -->

        <!-- Room's cross-process service: Mavick is one process, so it is never needed. -->
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            tools:node="remove" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Would load an emoji font at every launch; Android 13+ already ships current emoji. -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
