<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">#F5FFFFFF</color>
    <color name="widget_text">#FF1B1F24</color>
    <color name="widget_text_secondary">#FF5C6670</color>
    <color name="widget_overdue">#FFB3261E</color>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
